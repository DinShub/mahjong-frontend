{
  "name": "@mahjong/frontend",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "sync:contracts": "node scripts/sync-contracts.mjs",
    "check:contracts": "node scripts/sync-contracts.mjs --check",
    "sync:fixtures": "node scripts/sync-fixtures.mjs",
    "check:fixtures": "node scripts/sync-fixtures.mjs --check",
    "build:tiles": "node scripts/build-tile-sprite.mjs",
    "check:tiles": "node scripts/build-tile-sprite.mjs --check"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "rxjs": "~7.8.0",
    "socket.io-client": "^4.8.3",
    "tslib": "^2.3.0",
    "zod": "^4.4.3",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^1.22.5",
    "@analogjs/vitest-angular": "^1.22.5",
    "@angular-devkit/build-angular": "^19.2.27",
    "@angular/cli": "^19.2.27",
    "@angular/compiler-cli": "^19.2.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.0",
    "@vitest/coverage-v8": "^3.2.7",
    "angular-eslint": "^19.8.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.9.6",
    "socket.io": "^4.8.3",
    "svgo": "^4.0.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.7"
  }
}
